+namespace sfz {
+bool Synth::protectedNoteOn(int delay, int note, int velocity, uint64_t owner, const float* left, const float* right) noexcept {
+    impl_->protectedGainLeft_ = left; impl_->protectedGainRight_ = right;
+    impl_->protectedOwner_ = owner; impl_->protectedStarted_ = 0; noteOn(delay,note,velocity); impl_->protectedOwner_ = 0; impl_->protectedGainLeft_ = nullptr; impl_->protectedGainRight_ = nullptr; return impl_->protectedStarted_ != 0;
+}
+void Synth::protectedNoteOff(int delay, int note, uint64_t owner, const float* left, const float* right) noexcept {
+        Impl& impl = *impl_;
+    float velocity = 0;
+    bool found = false;
+    for (auto& voice : impl.voiceManager_) {
+        if (voice.isFree() || voice.protectedOwner != owner || voice.getTriggerEvent().type != TriggerEventType::NoteOn) continue;
+        velocity = voice.getTriggerEvent().value;
+        voice.registerNoteOff(delay,note,velocity);
+        found = true;
+    }
+    if (!found) return;
+    impl.protectedGainLeft_ = left; impl.protectedGainRight_ = right;
+    impl.protectedOwner_ = owner;
+    impl.resources_.getMidiState().noteOffEvent(delay,note,velocity);
+    impl.noteOffDispatch(delay,note,velocity);
+    impl.protectedOwner_ = 0; impl.protectedGainLeft_ = nullptr; impl.protectedGainRight_ = nullptr;
+}
+}
+uint64_t sfz::Synth::getProtectedRefusals() const noexcept { return impl_->protectedRefusals_; }
+void sfz::Synth::protectedLaneOff(int delay,const float* left) noexcept {for(auto &voice:impl_->voiceManager_)if(!voice.isFree()&&voice.protectedGainLeft==left)voice.off(delay,true);}
