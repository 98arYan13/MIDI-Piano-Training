+bool Synth::protectedNoteOn(int delay, int note, int velocity, uint64_t owner) noexcept {
+    impl_->protectedOwner_ = owner; impl_->protectedStarted_ = 0; noteOn(delay,note,velocity); impl_->protectedOwner_ = 0; return impl_->protectedStarted_ != 0;
